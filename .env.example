# Zetaris (local Docker)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# Running inside Docker (Docker Desktop)? localhost is the container, so use the host instead:
# ZETARIS_REST_URL=http://host.docker.internal:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
# Meterless Nightshift (copy URL + key from Nightshift Console)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# METERLESS_BASE_URL=http://host.docker.internal:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL_DEEP=meterless/deep
METERLESS_MODEL_FAST=meterless/fast
# Bound to "deep" in Nightshift Console > Apps (comments stay on their own line so docker --env-file reads clean values)
METERLESS_APP_DEEP=procurement-integrity
# Bound to "fast" in Nightshift Console > Apps
METERLESS_APP_FAST=procurement-integrity-fast
# Our containers
POSTGRES_USER=pi
POSTGRES_PASSWORD=change-me
S3_ENDPOINT=http://pi-s3:8333
S3_BUCKET=pi-acra
HMEM_URL=http://127.0.0.1:7070
# HMEM_URL=http://host.docker.internal:7070
# Privacy: HMAC key for the `?view=public` supplier pseudonyms (any long random string; keep it secret)
PSEUDONYM_KEY=change-me-long-random-string
# Runtime
# HTTP port for `python run.py --serve` (the Dockerfile exposes 8000)
PORT=8000
LOG_LEVEL=info
# SAMPLE_MODE=true with no ZETARIS_API_KEY / METERLESS_RUNTIME_TOKEN runs fully offline on recorded data
# (data/replay/<set>/). With keys set, live services are used and the recording is only a fallback.
SAMPLE_MODE=true
# Fallback recorded set when no set matches the request's agency and dates (a name under data/replay/ or a path)
REPLAY_SET=hdb-fy2425
MAX_RETRIES=2
LLM_CALL_CAP=40
SOURCE_TIMEOUT_SECONDS=20
